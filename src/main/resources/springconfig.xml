<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Fix 1: Make sure Pen implements Writer interface -->
    <bean id="P1" class="org.example.Pen">
    </bean>

    <bean id="writer" class="org.example.Pen">
    </bean>

    <bean id="P3" class="org.example.Pencil">
    </bean>

    <bean id="St1" class="org.example.Student" autowire="byName">
        <property name="writer" ref="writer"/> <!-- Now P1 exists -->
    </bean>

</beans>